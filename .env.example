# URL of the n8n webhook that receives Contact form submissions (see components/Contact.tsx).
# This is exposed to the browser (NEXT_PUBLIC_ prefix) because the form posts to it directly
# from the client — do not put credentials or secrets in this value.
# If unset, the form falls back to the n8n TEST webhook hardcoded in Contact.tsx —
# set this to point production submissions at a real workflow.
NEXT_PUBLIC_N8N_WEBHOOK_URL=
